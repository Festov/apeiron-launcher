<Window x:Class="Apeiron.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Microsoft sign-in"
        Height="700" Width="900"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="550" MinWidth="750"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20,16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AuthHeadingText" Text="Sign in"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="AuthSubtitleText" Text="Sign in with Microsoft"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceLightBrush}">
            <wv2:WebView2 x:Name="AuthWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>
    </Grid>
</Window>
