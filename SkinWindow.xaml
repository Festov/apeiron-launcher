<Window x:Class="Apeiron.SkinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Apeiron.Controls"
        Title="Skin"
        Width="920" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SkinThumbButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="48" Height="48"
                                CornerRadius="10"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                SnapsToDevicePixels="True">
                            <Border Background="Transparent">
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="8.5" RadiusY="8.5" Rect="0,0,45,45"/>
                                </Border.Clip>
                                <ContentPresenter/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogChrome"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource SurfaceLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Text="Skin"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="PreviewHost"
                        Grid.Column="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="#07090D"
                        SnapsToDevicePixels="True">
                    <controls:MinecraftSkinPreview3D x:Name="Preview3D"/>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="HintText" Grid.Row="0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="PresetsLabel" Text="Default skins"
                                   Style="{StaticResource SectionLabel}"/>
                        <Border Background="{DynamicResource SurfaceLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                            <StackPanel>
                                <TextBlock x:Name="ClassicPresetsLabel" Text="Classic"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <ItemsControl x:Name="ClassicPresetList" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SkinThumbButton}"
                                                    Click="StandardSkin_Click"
                                                    ToolTip="{Binding DisplayName}"
                                                    Tag="{Binding}">
                                                <Image Source="{Binding HeadPreview}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="SlimPresetsLabel" Text="Slim"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <ItemsControl x:Name="SlimPresetList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SkinThumbButton}"
                                                    Click="StandardSkin_Click"
                                                    ToolTip="{Binding DisplayName}"
                                                    Tag="{Binding}">
                                                <Image Source="{Binding HeadPreview}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HistorySection" Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock x:Name="HistoryLabel" Text="Account skins"
                                   Style="{StaticResource SectionLabel}"/>
                        <Border x:Name="HistoryHost"
                                Background="{DynamicResource SurfaceLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <ItemsControl x:Name="HistoryList" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SkinThumbButton}"
                                                    Click="HistorySkin_Click"
                                                    ToolTip="{Binding Alias}"
                                                    Tag="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Width="48" Height="48"
                                                                CornerRadius="10"
                                                                BorderThickness="1.5"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                SnapsToDevicePixels="True">
                                                            <Border Background="Transparent">
                                                                <Border.Clip>
                                                                    <RectangleGeometry RadiusX="8.5" RadiusY="8.5" Rect="0,0,45,45"/>
                                                                </Border.Clip>
                                                                <Image Source="{Binding HeadPreview}" Stretch="UniformToFill"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            </Border>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BrowseButton" Grid.Column="0" Content="Browse..."
                                            Style="{StaticResource DialogOutlinedButton}"
                                            HorizontalAlignment="Stretch"
                                            Click="BrowseButton_Click"/>
                                    <StackPanel x:Name="ModelRadioRow" Grid.Column="2"
                                                Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <RadioButton x:Name="ClassicRadio" Content="Classic"
                                                     GroupName="SkinModel" IsChecked="True"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Margin="0,0,14,0" VerticalAlignment="Center"
                                                     Checked="ModelRadio_Changed"/>
                                        <RadioButton x:Name="SlimRadio" Content="Slim"
                                                     GroupName="SkinModel"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Checked="ModelRadio_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Row="3"
                               FontSize="11"
                               Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource DialogOutlinedButton}"
                                Click="CancelButton_Click"/>
                        <Button x:Name="ApplyButton" Content="Apply"
                                Style="{StaticResource DialogAccentButton}"
                                Margin="8,0,0,0"
                                Click="ApplyButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
