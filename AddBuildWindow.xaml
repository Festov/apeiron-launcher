<Window x:Class="Apeiron.AddBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create instance"
        Height="Auto" Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="AddBuildComboBox" TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}"/>
        <Style x:Key="AddBuildComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource LauncherComboBoxItem}"/>
        <Style x:Key="AddBuildTextBox" TargetType="TextBox" BasedOn="{StaticResource LauncherTextBox}"/>
    </Window.Resources>

    <Border x:Name="DialogChrome"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Text="New instance"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameLabel" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="BuildNameTextBox"
                                 Style="{StaticResource AddBuildTextBox}"
                                 TabIndex="1"
                                 ToolTip="Optional display name"
                                 TextChanged="BuildNameTextBox_TextChanged"/>
                        <TextBlock x:Name="NameHintText" Text="Optional"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TypeLabel" Grid.Column="0" Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeComboBox" Grid.Column="1" VerticalAlignment="Center"
                              TabIndex="2"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                              SelectionChanged="TypeComboBox_SelectionChanged"/>
                </Grid>

                <Grid x:Name="LoaderRow" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoaderLabel" Grid.Column="0" Text="Модлоадер" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LoaderComboBox" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                              SelectionChanged="LoaderComboBox_SelectionChanged"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionSearchLabel" Grid.Column="0" Text="Search" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="VersionSearchTextBox" Grid.Column="1"
                             Style="{StaticResource AddBuildTextBox}"
                             TabIndex="3"
                             TextChanged="VersionSearchTextBox_TextChanged"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="McVersionLabel" Grid.Column="0" Text="MC version" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VersionComboBox" Grid.Column="0" VerticalAlignment="Center"
                                  TabIndex="4"
                                  Style="{StaticResource AddBuildComboBox}"
                                  ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                                  DisplayMemberPath="Display"
                                  SelectionChanged="VersionComboBox_SelectionChanged"/>
                        <Button x:Name="RefreshVersionsButton" Grid.Column="1" Content="↻"
                                TabIndex="5"
                                Style="{StaticResource DialogCloseButton}"
                                Width="32" Height="32" Margin="8,0,0,0"
                                Click="RefreshVersionsButton_Click"
                                ToolTip="Обновить список версий"/>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FilterLabel" Grid.Column="0" Text="Filter" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="ShowSnapshotsCheckBox" Grid.Column="1"
                              Style="{StaticResource LauncherCheckBox}"
                              Content="Показывать снапшоты и pre-release"
                              VerticalAlignment="Center"
                              Checked="ShowSnapshotsCheckBox_Changed"
                              Unchecked="ShowSnapshotsCheckBox_Changed"/>
                </Grid>

                <Grid x:Name="LoaderVersionRow" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoaderVersionLabel" Grid.Column="0" Text="Версия" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LoaderVersionComboBox" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="CancelButton" Content="Отмена"
                            TabIndex="9"
                            Style="{StaticResource DialogOutlinedButton}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="CreateButton" Content="Создать"
                            TabIndex="8"
                            Style="{StaticResource DialogAccentButton}"
                            Margin="8,0,0,0"
                            Click="CreateButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
