<Window x:Class="Apeiron.AddBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create instance"
        Height="Auto" Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="AddBuildComboBox" TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}"/>
        <Style x:Key="AddBuildComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource LauncherComboBoxItem}"/>
        <Style x:Key="AddBuildTextBox" TargetType="TextBox" BasedOn="{StaticResource LauncherTextBox}"/>
        <Style x:Key="ModpackListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModpackListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModpackListBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Padding="{TemplateBinding Padding}"
                                          Focusable="False"
                                          Background="{StaticResource SurfaceLightBrush}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ModpackItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="📦"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Image Width="40" Height="40"
                               Stretch="UniformToFill"
                               Source="{Binding IconImage}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#F3F0E8"/>
                    <TextBlock Text="{Binding SubtitleLine}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#A8B0C0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="DialogChrome"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Text="New instance"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameLabel" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="BuildNameTextBox"
                                 Style="{StaticResource AddBuildTextBox}"
                                 TabIndex="1"
                                 ToolTip="Optional display name"
                                 TextChanged="BuildNameTextBox_TextChanged"/>
                        <TextBlock x:Name="NameHintText" Text="Optional"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TypeLabel" Grid.Column="0" Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeComboBox" Grid.Column="1" VerticalAlignment="Center"
                              TabIndex="2"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                              SelectionChanged="TypeComboBox_SelectionChanged"/>
                </Grid>

                <!-- Vanilla / Modded fields -->
                <StackPanel x:Name="ClassicFieldsPanel">
                    <Grid x:Name="LoaderRow" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LoaderLabel" Grid.Column="0" Text="Модлоадер" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="LoaderComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource AddBuildComboBox}"
                                  ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                                  SelectionChanged="LoaderComboBox_SelectionChanged"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionSearchLabel" Grid.Column="0" Text="Search" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="VersionSearchTextBox" Grid.Column="1"
                                 Style="{StaticResource AddBuildTextBox}"
                                 TabIndex="3"
                                 TextChanged="VersionSearchTextBox_TextChanged"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="McVersionLabel" Grid.Column="0" Text="MC version" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VersionComboBox" Grid.Column="0" VerticalAlignment="Center"
                                      TabIndex="4"
                                      Style="{StaticResource AddBuildComboBox}"
                                      ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="VersionComboBox_SelectionChanged"/>
                            <Button x:Name="RefreshVersionsButton" Grid.Column="1" Content="↻"
                                    TabIndex="5"
                                    Style="{StaticResource DialogCloseButton}"
                                    Width="32" Height="32" Margin="8,0,0,0"
                                    Click="RefreshVersionsButton_Click"
                                    ToolTip="Обновить список версий"/>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilterLabel" Grid.Column="0" Text="Filter" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="ShowSnapshotsCheckBox" Grid.Column="1"
                                  Style="{StaticResource LauncherCheckBox}"
                                  Content="Показывать снапшоты и pre-release"
                                  VerticalAlignment="Center"
                                  Checked="ShowSnapshotsCheckBox_Changed"
                                  Unchecked="ShowSnapshotsCheckBox_Changed"/>
                    </Grid>

                    <Grid x:Name="LoaderVersionRow" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LoaderVersionLabel" Grid.Column="0" Text="Версия" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="LoaderVersionComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource AddBuildComboBox}"
                                  ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"/>
                    </Grid>
                </StackPanel>

                <!-- ModPacks fields -->
                <StackPanel x:Name="ModpackFieldsPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ModpackPlatformLabel" Grid.Column="0" Text="Platform" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ModpackPlatformComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource AddBuildComboBox}"
                                  ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                                  SelectionChanged="ModpackPlatformComboBox_SelectionChanged"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ModpackSearchLabel" Grid.Column="0" Text="Search packs" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModpackSearchTextBox"
                                     Style="{StaticResource AddBuildTextBox}"
                                     TextChanged="ModpackSearchTextBox_TextChanged"/>
                            <Button x:Name="RefreshModpacksButton" Grid.Column="1" Content="↻"
                                    Style="{StaticResource DialogCloseButton}"
                                    Width="32" Height="32" Margin="8,0,0,0"
                                    Click="RefreshModpacksButton_Click"/>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="ModpackListLabel" Text="Popular packs"
                               Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceLightBrush}"
                            Margin="0,0,0,8">
                        <ListBox x:Name="ModpackListBox"
                                 Height="320"
                                 Style="{StaticResource ModpackListBox}"
                                 ItemTemplate="{StaticResource ModpackItemTemplate}"
                                 SelectionChanged="ModpackListBox_SelectionChanged"/>
                    </Border>

                    <TextBlock x:Name="ModpackStatusText"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <ProgressBar x:Name="ModpackProgressBar"
                                 Height="6"
                                 Minimum="0" Maximum="1"
                                 Visibility="Collapsed"
                                 Margin="0,0,0,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="CancelButton" Content="Отмена"
                            TabIndex="9"
                            Style="{StaticResource DialogOutlinedButton}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="CreateButton" Content="Создать"
                            TabIndex="8"
                            Style="{StaticResource DialogAccentButton}"
                            Margin="8,0,0,0"
                            Click="CreateButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
