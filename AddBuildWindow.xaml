<Window x:Class="Apeiron.AddBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create instance"
        Height="Auto" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource SurfaceBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <Style x:Key="AddBuildComboBox" TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="AddBuildComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource LauncherComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AddBuildTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="DialogOutlinedButton" TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,4,0">
                    <TextBlock x:Name="TitleText" Text="New instance"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="12,10,12,12">

                <!-- Название -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameLabel" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="BuildNameTextBox"
                                 Style="{StaticResource AddBuildTextBox}"
                                 TabIndex="1"
                                 ToolTip="Optional display name"
                                 TextChanged="BuildNameTextBox_TextChanged"/>
                        <TextBlock x:Name="NameHintText" Text="Optional"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Тип -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TypeLabel" Grid.Column="0" Text="Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeComboBox" Grid.Column="1" Height="34" VerticalAlignment="Center"
                              TabIndex="2"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                              SelectionChanged="TypeComboBox_SelectionChanged"/>
                </Grid>

                <!-- Модлоадер -->
                <Grid x:Name="LoaderRow" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoaderLabel" Grid.Column="0" Text="Модлоадер" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LoaderComboBox" Grid.Column="1" Height="34" VerticalAlignment="Center"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                              SelectionChanged="LoaderComboBox_SelectionChanged"/>
                </Grid>

                <!-- Поиск версии -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionSearchLabel" Grid.Column="0" Text="Search" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="VersionSearchTextBox" Grid.Column="1"
                             Style="{StaticResource AddBuildTextBox}"
                             TabIndex="3"
                             TextChanged="VersionSearchTextBox_TextChanged"/>
                </Grid>

                <!-- Версия MC -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="McVersionLabel" Grid.Column="0" Text="MC version" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VersionComboBox" Grid.Column="0" Height="34" VerticalAlignment="Center"
                                  TabIndex="4"
                                  Style="{StaticResource AddBuildComboBox}"
                                  ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"
                                  DisplayMemberPath="Display"
                                  SelectionChanged="VersionComboBox_SelectionChanged"/>
                        <Button x:Name="RefreshVersionsButton" Grid.Column="1" Content="↻"
                                TabIndex="5"
                                Style="{StaticResource DialogCloseButton}"
                                Width="34" Height="34" Margin="6,0,0,0"
                                Click="RefreshVersionsButton_Click"
                                ToolTip="Обновить список версий"/>
                    </Grid>
                </Grid>

                <!-- Снапшоты -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FilterLabel" Grid.Column="0" Text="Filter" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="ShowSnapshotsCheckBox" Grid.Column="1"
                              Style="{StaticResource LauncherCheckBox}"
                              Content="Показывать снапшоты и pre-release"
                              VerticalAlignment="Center"
                              Checked="ShowSnapshotsCheckBox_Changed"
                              Unchecked="ShowSnapshotsCheckBox_Changed"/>
                </Grid>

                <!-- Версия лоадера -->
                <Grid x:Name="LoaderVersionRow" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoaderVersionLabel" Grid.Column="0" Text="Версия" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LoaderVersionComboBox" Grid.Column="1" Height="34" VerticalAlignment="Center"
                              Style="{StaticResource AddBuildComboBox}"
                              ItemContainerStyle="{StaticResource AddBuildComboBoxItem}"/>
                </Grid>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="CancelButton" Content="Отмена"
                            TabIndex="9"
                            Style="{StaticResource DialogOutlinedButton}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="CreateButton" Content="Создать"
                            TabIndex="8"
                            Style="{StaticResource DialogAccentButton}"
                            Margin="8,0,0,0"
                            Click="CreateButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
