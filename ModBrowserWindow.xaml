<Window x:Class="Apeiron.ModBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mods catalog"
        Height="Auto" Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModBrowserTextBox" TargetType="TextBox" BasedOn="{StaticResource LauncherTextBox}"/>
        <Style x:Key="ModBrowserComboBox" TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}"/>
        <Style x:Key="ModBrowserComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource LauncherComboBoxItem}"/>
        <Style x:Key="ModListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModListBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Padding="{TemplateBinding Padding}"
                                          Focusable="False"
                                          Background="{StaticResource SurfaceLightBrush}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ModItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="🧩"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Image Width="40" Height="40"
                               Stretch="UniformToFill"
                               Source="{Binding IconImage}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#F3F0E8"/>
                    <TextBlock Text="{Binding SubtitleLine}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#A8B0C0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="DialogChrome"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Text="Mods catalog"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PlatformLabel" Grid.Column="0" Text="Platform" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="SourceComboBox" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource ModBrowserComboBox}"
                              ItemContainerStyle="{StaticResource ModBrowserComboBoxItem}"
                              SelectionChanged="SourceComboBox_SelectionChanged"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SearchLabel" Grid.Column="0" Text="Search" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource ModBrowserTextBox}"
                                 TextChanged="SearchTextBox_TextChanged"
                                 KeyDown="SearchTextBox_KeyDown"/>
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="↻"
                                Style="{StaticResource DialogCloseButton}"
                                Width="32" Height="32" Margin="8,0,0,0"
                                Click="RefreshButton_Click"/>
                    </Grid>
                </Grid>

                <TextBlock x:Name="ListLabel" Text="Popular mods"
                           Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceLightBrush}"
                        Margin="0,0,0,8">
                    <ListBox x:Name="ModsListBox"
                             Height="320"
                             Style="{StaticResource ModListBox}"
                             ItemTemplate="{StaticResource ModItemTemplate}"
                             SelectionChanged="ModsListBox_SelectionChanged"/>
                </Border>

                <TextBlock x:Name="StatusText"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           MinHeight="16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource DialogOutlinedButton}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource DialogAccentButton}"
                            Margin="8,0,0,0" Click="InstallButton_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
