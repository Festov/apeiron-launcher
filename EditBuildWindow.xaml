<Window x:Class="Apeiron.EditBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit instance"
        Height="Auto" Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource SurfaceBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <Style x:Key="EditTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditCompactTextBox" TargetType="TextBox" BasedOn="{StaticResource EditTextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MaxHeight" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="EditNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource EditCompactTextBox}">
            <Setter Property="MaxLength" Value="4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="DialogOutlinedButton" TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="DialogWarningButton" TargetType="Button" BasedOn="{StaticResource DialogOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="DialogCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,4,0">
                    <TextBlock x:Name="TitleText" Text="Edit instance"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="12,10,12,12">

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameLabel" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameTextBox" Grid.Column="1" Style="{StaticResource EditTextBox}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProfileLabel" Grid.Column="0" Text="Profile" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="ProfileInfoText" Grid.Column="1"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>

                <Grid x:Name="ModsEnabledRow" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModsLabel" Grid.Column="0" Text="Mods" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="ModsEnabledCheckBox" Grid.Column="1"
                              Style="{StaticResource LauncherCheckBox}"
                              Content="Использовать моды"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="ModsSection" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModsListLabel" Grid.Column="0" Text="List" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,8,0"/>
                    <Border Grid.Column="1"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{DynamicResource SurfaceLightBrush}"
                            MinHeight="200" MaxHeight="300"
                            AllowDrop="True"
                            DragOver="ModsSection_DragOver"
                            Drop="ModsSection_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4">
                                <Button x:Name="AddModButton" Content="Add mod" Style="{StaticResource DialogOutlinedButton}"
                                        Click="AddMod_Click" Padding="8,4" Height="26"/>
                                <Button x:Name="OpenModsFolderButton" Content="Open folder" Style="{StaticResource DialogOutlinedButton}"
                                        Click="OpenModsFolder_Click" Padding="8,4" Height="26" Margin="6,0,0,0"/>
                                <Button x:Name="RefreshModsButton" Content="Refresh" Style="{StaticResource DialogOutlinedButton}"
                                        Click="RefreshMods_Click" Margin="6,0,0,0" Padding="8,4" Height="26"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="4,0,4,4">
                                <ItemsControl x:Name="ModsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding ListLabel}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Style="{StaticResource LauncherCheckBox}"
                                                      Margin="2,3" Checked="ModCheckBox_Changed" Unchecked="ModCheckBox_Changed"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoModsText" Grid.Row="1"
                                       Text="Нет модов. Перетащите .jar сюда или нажмите «Добавить мод»."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LaunchLabel" Grid.Column="0" Text="Launch" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="DefaultBuildCheckBox" Grid.Column="1"
                              Style="{StaticResource LauncherCheckBox}"
                              Content="Основная сборка (выбирается при старте)"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="JvmLabel" Grid.Column="0" Text="JVM" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="JvmArgsTextBox" Grid.Column="1"
                             Style="{StaticResource EditCompactTextBox}"
                             ToolTip="Дополнительные флаги Java, например: -XX:+UseG1GC"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RamLabel" Grid.Column="0" Text="RAM" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="UseGlobalRamCheckBox" Style="{StaticResource LauncherCheckBox}"
                                  Content="Global" VerticalAlignment="Center"
                                  Checked="UseGlobalRamCheckBox_Changed" Unchecked="UseGlobalRamCheckBox_Changed"/>
                        <TextBox x:Name="RamGbTextBox"
                                 Style="{StaticResource EditNumericTextBox}"
                                 Width="52" Margin="10,0,0,0"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WindowLabel" Grid.Column="0" Text="Window" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="ResolutionWidthTextBox"
                                 Style="{StaticResource EditNumericTextBox}"
                                 Width="52" PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 ToolTip="Ширина (пусто = по умолчанию)"/>
                        <TextBlock Text="×" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="6,0"/>
                        <TextBox x:Name="ResolutionHeightTextBox"
                                 Style="{StaticResource EditNumericTextBox}"
                                 Width="52" PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 ToolTip="Высота (пусто = по умолчанию)"/>
                        <CheckBox x:Name="FullscreenCheckBox" Style="{StaticResource LauncherCheckBox}"
                                  Content="Полный экран" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Margin="0,4,0,0"
                        Padding="0,10,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="FolderButton" Grid.Row="0" Grid.Column="0"
                                    Content="Folder" Style="{StaticResource DialogOutlinedButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenInstanceFolder_Click"
                                    ToolTip="Открыть папку сборки"/>
                            <Button x:Name="ExportButton" Grid.Row="0" Grid.Column="2"
                                    Content="Export" Style="{StaticResource DialogOutlinedButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="ExportButton_Click"/>
                            <Button x:Name="ImportButton" Grid.Row="2" Grid.Column="0"
                                    Content="Import" Style="{StaticResource DialogOutlinedButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="ImportButton_Click"/>
                            <Button x:Name="BackupButton" Grid.Row="2" Grid.Column="2"
                                    Content="Backup" Style="{StaticResource DialogOutlinedButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="BackupButton_Click"/>
                            <Button x:Name="DuplicateButton" Grid.Row="4" Grid.Column="0"
                                    Content="Дублировать" Style="{StaticResource DialogOutlinedButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="DuplicateButton_Click"/>
                            <Button x:Name="ReinstallButton" Grid.Row="4" Grid.Column="2"
                                    Content="Переустановить" Style="{StaticResource DialogWarningButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="ReinstallButton_Click"/>
                            <Button x:Name="DeleteButton" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                    Content="Удалить" Style="{StaticResource DialogDangerButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="DeleteButton_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" x:Name="CancelBtn" Style="{StaticResource DialogOutlinedButton}" Click="CancelButton_Click"/>
                            <Button Content="Save" x:Name="SaveBtn" Style="{StaticResource DialogAccentButton}"
                                    Margin="8,0,0,0" Click="SaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
