<Window x:Class="Apeiron.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Apeiron"
        Title="Settings"
        Height="Auto" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogChrome"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText"
                                   Text="Settings"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource DialogCloseButton}"
                            Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RamLabel" Grid.Column="0" Text="RAM (GB)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RamTextBox" Grid.Column="1"
                             Style="{StaticResource LauncherNumericTextBox}"
                             HorizontalAlignment="Left"
                             TabIndex="1"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Language" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1"
                              TabIndex="2"
                              Style="{StaticResource SettingsComboBox}"
                              ItemContainerStyle="{StaticResource LauncherComboBoxItem}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Code"
                              HorizontalAlignment="Left"/>
                </Grid>

                <CheckBox x:Name="CheckForUpdatesCheckBox" Style="{StaticResource LauncherCheckBox}"
                          Margin="0,0,0,14" TabIndex="3"
                          Content="Check for updates on startup"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="OpenLogsButton" Content="Open logs" Style="{StaticResource DialogOutlinedButton}" Click="OpenLogs_Click"/>
                    <Button x:Name="CheckUpdatesButton" Content="Check updates" Style="{StaticResource DialogOutlinedButton}"
                            Margin="8,0,0,0" Click="CheckUpdates_Click"/>
                </StackPanel>

                <TextBlock x:Name="VersionText"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource DialogOutlinedButton}" Click="CancelButton_Click"/>
                    <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource DialogAccentButton}"
                            Margin="8,0,0,0" Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
