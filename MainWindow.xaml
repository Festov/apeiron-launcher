<Window x:Class="Apeiron.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Apeiron"
        Title="Apeiron Launcher"
        Height="780" Width="980"
        MinHeight="780" MinWidth="980"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="ConsoleRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        
        <Style x:Key="ConsoleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Border Background="{DynamicResource BgBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            AllowDrop="True"
            DragOver="MainWindow_DragOver"
            Drop="MainWindow_Drop">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- ===== ЗАГОЛОВОК ===== -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,4,0">
                    <TextBlock Text="Apeiron Launcher"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButton}" Click="SettingsButton_Click" ToolTip="{loc:Loc main.settings_tooltip}">
                            <TextBlock Text="⚙" FontSize="13"/>
                        </Button>
                        <Button x:Name="ThemeToggle" Style="{StaticResource TitleBarButton}" Click="ThemeToggle_Click">
                            <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="12"/>
                        </Button>
                        <Button Content="─" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click"/>
                        <Button Content="☐" Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click"/>
                        <Button Content="✕" Style="{StaticResource TitleBarButton}" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- ===== ЛЕВАЯ ПАНЕЛЬ ===== -->
                <Border x:Name="LeftPanel" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ===== ПРОФИЛЬ ===== -->
                            <Border x:Name="ProfileBorder" Background="{DynamicResource SurfaceLightBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="SkinBorder" Grid.Column="0"
                                            Width="52" Height="52"
                                            Background="{DynamicResource BorderBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            SnapsToDevicePixels="True">
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,52,52"/>
                                        </Border.Clip>
                                        <Image x:Name="SkinImage" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UserInfoText" Text="Guest"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="UserStatusText" Text="Sign in to play online"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,8"
                                                   TextWrapping="Wrap"/>
                                        <Button x:Name="AuthButton" Style="{StaticResource AccentButton}"
                                                Click="AuthButton_Click"
                                                Padding="10,4" Height="28" HorizontalAlignment="Left">
                                            <TextBlock x:Name="AuthButtonText" Text="Sign in" FontSize="12"/>
                                        </Button>
                                        <Button x:Name="LogoutButton"
                                                Style="{DynamicResource OutlinedButton}"
                                                Click="LogoutButton_Click"
                                                Visibility="Collapsed"
                                                Padding="10,4" Height="28" HorizontalAlignment="Left">
                                            <TextBlock x:Name="LogoutButtonText" Text="Sign out" FontSize="12"/>
                                        </Button>
                                        <StackPanel x:Name="OfflineNameRow" Visibility="Collapsed" Margin="0,6,0,0">
                                            <TextBlock x:Name="OfflineNameLabel" Text="Offline name"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="OfflineNameTextBox" MaxLength="16"
                                                     Height="28" FontSize="12" Padding="6,4"
                                                     TabIndex="1"
                                                     ToolTip="3–16 characters: a-z, 0-9, _"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     PreviewTextInput="OfflineNameTextBox_PreviewTextInput"
                                                     DataObject.Pasting="OfflineNameTextBox_Pasting"
                                                     TextChanged="OfflineNameTextBox_TextChanged"
                                                     LostFocus="OfflineNameTextBox_LostFocus"
                                                     KeyDown="OfflineNameTextBox_KeyDown"/>
                                            <TextBlock x:Name="OfflineNameHintText"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock x:Name="OfflineNameErrorText"
                                                       FontSize="10" Foreground="#DC2626"
                                                       Margin="0,2,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>
                            
                            <TextBlock x:Name="BuildsHeaderText" Text="Instances" FontSize="13" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource SurfaceLightBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <ComboBox x:Name="BuildsComboBox" 
                                              Style="{StaticResource LauncherComboBox}"
                                              ItemContainerStyle="{StaticResource LauncherComboBoxItem}"
                                              SelectionChanged="BuildsComboBox_SelectionChanged"
                                              IsSynchronizedWithCurrentItem="True">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ComboDisplay}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="➕" 
                                                Style="{DynamicResource WindowControlButton}"
                                                FontSize="14" Width="30" Height="30"
                                                Click="AddBuild_Click"
                                                ToolTip="{loc:Loc main.add_build_tooltip}"/>
                                        
                                        <Button Content="📦"
                                                Style="{DynamicResource WindowControlButton}"
                                                FontSize="14" Width="30" Height="30"
                                                Margin="4,0,0,0"
                                                Click="ImportModpack_Click"
                                                ToolTip="{loc:Loc main.import_modpack_tooltip}"/>
                                        
                                        <Button Content="✏️"
                                                Style="{DynamicResource WindowControlButton}"
                                                FontSize="14" Width="30" Height="30"
                                                Margin="4,0,0,0"
                                                Click="EditBuild_Click"
                                                ToolTip="{loc:Loc main.edit_build_tooltip}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- ===== ПРАВАЯ ПАНЕЛЬ ===== -->
                <Border x:Name="RightPanel" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- ===== СТАТУС ===== -->
                        <Border x:Name="StatusBorder" Grid.Row="0" Background="{DynamicResource SurfaceLightBrush}" Padding="10" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LogText" Text="Ready" FontSize="14" FontWeight="500" Foreground="#059669"/>
                                <ProgressBar x:Name="DownloadProgress" Height="4" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Margin="0,8,0,0" BorderThickness="0"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProgressText" Grid.Column="0"
                                               Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="Collapsed" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <Button x:Name="CancelDownloadButton" Grid.Column="1"
                                            Style="{StaticResource OutlinedButton}"
                                            Content="Cancel" Visibility="Collapsed"
                                            Padding="8,2" Height="24" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="CancelDownload_Click"/>
                                    <Button x:Name="OpenInstallLogButton" Grid.Column="1"
                                            Style="{StaticResource OutlinedButton}"
                                            Content="Open log" Visibility="Collapsed"
                                            Padding="8,2" Height="24" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="OpenInstallLog_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- ===== КОНСОЛЬ ===== -->
                        <Border x:Name="ConsoleBorder" Grid.Row="1" Style="{StaticResource ConsoleBorderStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock x:Name="ConsoleHeaderText" Grid.Column="0" Text="Console" FontSize="11" FontWeight="600" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="ClearConsoleButton" Grid.Column="1" Style="{DynamicResource WindowControlButton}" Click="ClearConsole_Click" Content="🗑️" Width="30" Height="24" FontSize="12"/>
                                </Grid>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <RichTextBox x:Name="ConsoleRichTextBox" Style="{StaticResource ConsoleRichTextBoxStyle}">
                                        <RichTextBox.Document>
                                            <FlowDocument>
                                                <Paragraph>
                                                    <Run Text=""/>
                                                </Paragraph>
                                            </FlowDocument>
                                        </RichTextBox.Document>
                                    </RichTextBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- ===== КНОПКИ ===== -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Click="PlayButton_Click" IsEnabled="False" FontSize="16" Padding="24,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PlayButtonIcon" Text="▶ " FontSize="18"/>
                                    <TextBlock x:Name="PlayButtonLabel" Text="Play" FontSize="16"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>