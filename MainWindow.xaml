<Window x:Class="Apeiron.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Apeiron"
        Title="Apeiron Launcher"
        Height="760" Width="1040"
        MinHeight="760" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            AllowDrop="True"
            DragOver="MainWindow_DragOver"
            Drop="MainWindow_Drop">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="APEIRON"
                                   FontSize="14" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="LAUNCHER"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="8,1,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AppVersionLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="12,1,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButton}"
                                Click="SettingsButton_Click"
                                ToolTip="{loc:Loc main.settings_tooltip}"
                                Margin="0,0,4,0">
                            <Path Data="M9.5,2 L10.5,2 L11.2,4.2 L13.2,3.5 L14.2,4.5 L13.5,6.5 L15.5,7.2 L15.5,8.8 L13.5,9.5 L14.2,11.5 L13.2,12.5 L11.2,11.8 L10.5,14 L9.5,14 L8.8,11.8 L6.8,12.5 L5.8,11.5 L6.5,9.5 L4.5,8.8 L4.5,7.2 L6.5,6.5 L5.8,4.5 L6.8,3.5 L8.8,4.2 Z M10,6.5 A1.5,1.5 0 1 0 10,9.5 A1.5,1.5 0 1 0 10,6.5 Z"
                                  Stretch="Uniform" Width="14" Height="14"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Content="─" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow_Click"/>
                        <Button Content="☐" Style="{StaticResource TitleBarButton}" Click="MaximizeWindow_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Width="36" Height="30" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A0C10" Offset="0"/>
                        <GradientStop Color="#10131A" Offset="0.45"/>
                        <GradientStop Color="#16110C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left rail -->
                    <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Profile -->
                            <Border x:Name="ProfileBorder" Grid.Row="0"
                                    Background="{DynamicResource SurfaceLightBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SkinBorder" Grid.Column="0"
                                                Width="56" Height="56"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="12"
                                                VerticalAlignment="Top"
                                                SnapsToDevicePixels="True"
                                                ClipToBounds="True"
                                                Cursor="Hand"
                                                ToolTip="{loc:Loc skin.change_tooltip}"
                                                MouseLeftButtonDown="SkinBorder_MouseLeftButtonDown">
                                            <!-- Inner radius = 12 - 1.5 so fill matches the stroke curve -->
                                            <Border CornerRadius="10.5" Background="Transparent" IsHitTestVisible="False">
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="10.5" RadiusY="10.5" Rect="0,0,53,53"/>
                                                </Border.Clip>
                                                <Image x:Name="SkinImage" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="UserInfoText" Text="Guest"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="UserStatusText" Text="Sign in to play online"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <ComboBox x:Name="AccountComboBox"
                                              Style="{StaticResource LauncherComboBox}"
                                              ItemContainerStyle="{StaticResource LauncherComboBoxItem}"
                                              Margin="0,12,0,0"
                                              Visibility="Collapsed"
                                              SelectionChanged="AccountComboBox_SelectionChanged"/>

                                    <Button x:Name="AuthButton" Style="{StaticResource AccentButton}"
                                            Click="AuthButton_Click"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Stretch"
                                            Padding="12,8" Height="34">
                                        <TextBlock x:Name="AuthButtonText" Text="Sign in" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="LogoutButton"
                                            Style="{StaticResource OutlinedButton}"
                                            Click="LogoutButton_Click"
                                            Visibility="Collapsed"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Padding="12,8" Height="34">
                                        <TextBlock x:Name="LogoutButtonText" Text="Sign out" FontSize="12"/>
                                    </Button>

                                    <StackPanel x:Name="OfflineNameRow" Visibility="Collapsed" Margin="0,12,0,0">
                                        <TextBlock x:Name="OfflineNameLabel" Text="Offline name"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="OfflineNameTextBox" MaxLength="16"
                                                 Style="{StaticResource LauncherTextBox}"
                                                 TabIndex="1"
                                                 ToolTip="3–16 characters: a-z, 0-9, _"
                                                 PreviewTextInput="OfflineNameTextBox_PreviewTextInput"
                                                 DataObject.Pasting="OfflineNameTextBox_Pasting"
                                                 TextChanged="OfflineNameTextBox_TextChanged"
                                                 LostFocus="OfflineNameTextBox_LostFocus"
                                                 KeyDown="OfflineNameTextBox_KeyDown"/>
                                        <TextBlock x:Name="OfflineNameHintText"
                                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock x:Name="OfflineNameErrorText"
                                                   FontSize="10" Foreground="{DynamicResource ErrorBrush}"
                                                   Margin="0,3,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Instances -->
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="BuildsHeaderText" Text="INSTANCES"
                                           Style="{StaticResource SectionLabel}"/>
                                <ComboBox x:Name="BuildsComboBox"
                                          Style="{StaticResource LauncherComboBox}"
                                          ItemContainerStyle="{StaticResource LauncherComboBoxItem}"
                                          SelectionChanged="BuildsComboBox_SelectionChanged"
                                          IsSynchronizedWithCurrentItem="True">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ComboDisplay}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <Button x:Name="AddBuildButton"
                                            Content="Create"
                                            Style="{StaticResource SidebarActionButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,4,0"
                                            Click="AddBuild_Click"
                                            ToolTip="{loc:Loc main.add_build_tooltip}"/>
                                    <Button x:Name="ImportModpackButton"
                                            Content="Modpack"
                                            Style="{StaticResource SidebarActionButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="2,0"
                                            Click="ImportModpack_Click"
                                            ToolTip="{loc:Loc main.import_modpack_tooltip}"/>
                                    <Button x:Name="EditBuildButton"
                                            Content="Edit"
                                            Style="{StaticResource SidebarActionButton}"
                                            HorizontalAlignment="Stretch"
                                            Margin="4,0,0,0"
                                            Click="EditBuild_Click"
                                            ToolTip="{loc:Loc main.edit_build_tooltip}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main stage -->
                    <Border x:Name="RightPanel" Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Status -->
                            <Border x:Name="StatusBorder" Grid.Row="0"
                                    Background="{DynamicResource SurfaceLightBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="LogText"
                                               Text="{Binding StatusText}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                    <ProgressBar x:Name="DownloadProgress" Height="6"
                                                 Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                                 Background="{DynamicResource SurfaceRaisedBrush}"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                                                 Margin="0,12,0,0" BorderThickness="0"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProgressText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"/>
                                        <Button x:Name="CancelDownloadButton" Grid.Column="1"
                                                Style="{StaticResource OutlinedButton}"
                                                Content="Cancel"
                                                Visibility="{Binding IsCancelDownloadVisible, Converter={StaticResource BoolToVis}}"
                                                Padding="10,3" Height="26" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="CancelDownload_Click"/>
                                        <Button x:Name="OpenInstallLogButton" Grid.Column="1"
                                                Style="{StaticResource OutlinedButton}"
                                                Content="Open log"
                                                Visibility="{Binding IsOpenInstallLogVisible, Converter={StaticResource BoolToVis}}"
                                                Padding="10,3" Height="26" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="OpenInstallLog_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Console -->
                            <Border x:Name="ConsoleBorder" Grid.Row="1"
                                    Background="{DynamicResource ConsoleBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="0"
                                    Margin="0,0,0,16"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="{DynamicResource SurfaceLightBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="11,11,0,0"
                                            Padding="14,8">
                                        <Grid>
                                            <TextBlock x:Name="ConsoleHeaderText"
                                                       Text="CONSOLE"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="ClearConsoleButton"
                                                    Style="{StaticResource GhostIconButton}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Width="28" Height="28"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Click="ClearConsole_Click"
                                                    ToolTip="Clear">
                                                <Path Width="10" Height="10"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M0,0 L1,1 M1,0 L0,1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4">
                                        <RichTextBox x:Name="ConsoleRichTextBox"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource ConsoleTextBrush}"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     FontSize="11.5"
                                                     BorderThickness="0"
                                                     IsReadOnly="True"
                                                     Padding="12,10"
                                                     CaretBrush="{DynamicResource AccentBrush}">
                                            <RichTextBox.Document>
                                                <FlowDocument>
                                                    <Paragraph>
                                                        <Run Text=""/>
                                                    </Paragraph>
                                                </FlowDocument>
                                            </RichTextBox.Document>
                                        </RichTextBox>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Play -->
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                <Button x:Name="PlayButton"
                                        Style="{StaticResource PlayButton}"
                                        Click="PlayButton_Click"
                                        IsEnabled="{Binding PlayButtonEnabled}">
                                    <TextBlock Text="{Binding PlayButtonText}" FontSize="16" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Dims content while modal dialogs are open -->
            <Border x:Name="DialogShadeOverlay"
                    Grid.RowSpan="2"
                    Background="#B307090D"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"
                    Panel.ZIndex="200"/>
        </Grid>
    </Border>
</Window>
