<Window x:Class="Apeiron.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome"
        Height="Auto" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="OnboardComboBox" TargetType="ComboBox" BasedOn="{StaticResource LauncherComboBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogChrome"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Text="Welcome"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">
                <TextBlock x:Name="IntroText"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Language" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1"
                              Style="{StaticResource OnboardComboBox}"
                              ItemContainerStyle="{StaticResource LauncherComboBoxItem}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Code"
                              HorizontalAlignment="Left"/>
                </Grid>

                <Button x:Name="CreateInstanceButton"
                        Content="Create first instance"
                        Style="{StaticResource DialogAccentButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="CreateInstance_Click"/>

                <Button x:Name="SkipButton"
                        Content="Skip"
                        Style="{StaticResource DialogOutlinedButton}"
                        HorizontalAlignment="Stretch"
                        Click="Skip_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
